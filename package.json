{
  "name": "spendproof",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "dev:mock": "SPENDPROOF_FORCE_MOCK=1 next dev",
    "proofs:record": "tsx scripts/record-proofs.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.111",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "@paypal/react-paypal-js": "^10.6.1",
    "ai": "^7.0.162",
    "better-sqlite3": "^13.0.3",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "z3-solver": "^5.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
