# Spendproof runs with none of these set: every service falls back to its mock,
# and the status chips in the header say which mode is active.
# Copy to .env.local for `npm run dev`. Never commit real values.

# PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: a sandbox personal account you log in with on the PayPal top-up button
PAYPAL_SANDBOX_BUYER_EMAIL=

# Optional: real sandbox personal accounts to receive the demo payouts.
# Without them payouts to the fictional addresses end UNCLAIMED in the sandbox.
SANDBOX_RECEIVER_SAM=
SANDBOX_RECEIVER_AVA=

# Gemini API (aistudio.google.com → Get API key). Free tier is fine.
GOOGLE_GENERATIVE_AI_API_KEY=
# Empty = gemini-3.8-flash (newest Flash on the free tier), falling back to gemini-2.5-flash when busy.
AI_MODEL=

# Force every adapter into mock mode even when keys are present (1 to enable).
SPENDPROOF_FORCE_MOCK=
# SQLite file location (default ./data/spendproof.db)
DATABASE_PATH=

# Not used by Spendproof (listed in the shared hackathon environment only).
BRYNTUM_EMAIL=
AG_GRID_LICENSE_KEY=
